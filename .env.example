# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never expose a service role key in NEXT_PUBLIC variables or client code.
# Configure private server-only secrets in Vercel Environment Variables.
# Supabase server-side admin key (server only; never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=DOORA <noreply@your-verified-domain.com>
NEXT_PUBLIC_SITE_URL=https://doora-app-wolf-03d1.vercel.app
